{
  "name": "picc",
  "version": "0.1.0",
  "description": "Agentic harness that runs Claude Code projects unchanged on GPT/Codex models, built as an extension bundle on Pi.",
  "type": "module",
  "license": "MIT",
  "author": "Arne <arne@idedeluxe.com>",
  "homepage": "https://github.com/ArneDeutsch/PiCC#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArneDeutsch/PiCC.git"
  },
  "bugs": {
    "url": "https://github.com/ArneDeutsch/PiCC/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "gpt",
    "chatgpt",
    "agent",
    "coding-agent",
    "harness",
    "pi",
    "skills",
    "subagents",
    "worktree"
  ],
  "bin": {
    "picc": "bin/picc.mjs"
  },
  "files": [
    "src",
    "picc",
    "bin",
    "examples",
    "doc/*.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:test",
    "test": "npm run test:unit && npm run test:e2e",
    "verify": "npm run typecheck:all && npm test",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"**/e2e-*.test.ts\"",
    "test:e2e": "node scripts/check-real-pi.mjs && vitest run test/e2e-",
    "test:coverage": "vitest run --coverage --exclude \"**/e2e-*.test.ts\"",
    "gen:capabilities": "node scripts/gen-capability-matrix.mjs",
    "setup": "npm ci && npm link",
    "hooks:install": "git config core.hooksPath .githooks",
    "update:pi": "node scripts/update-pi-suite.mjs",
    "preversion": "npm run verify",
    "prepublishOnly": "npm run verify",
    "test:source": "vitest run --exclude \"**/e2e-packaged-launcher.test.ts\"",
    "test:packaged": "vitest run test/e2e-packaged-launcher.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.0",
    "@earendil-works/pi-ai": "0.82.0",
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@earendil-works/pi-tui": "0.82.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "picomatch": "^4.0.5",
    "typebox": "1.1.38",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
