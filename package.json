{
  "name": "picc",
  "version": "0.1.0",
  "description": "Agentic harness that runs Claude Code projects unchanged on GPT/Codex models, built as an extension bundle on Pi.",
  "type": "module",
  "license": "MIT",
  "author": "Arne <arne@idedeluxe.com>",
  "homepage": "https://github.com/arne/picc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arne/picc.git"
  },
  "bugs": {
    "url": "https://github.com/arne/picc/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "gpt",
    "chatgpt",
    "agent",
    "coding-agent",
    "harness",
    "pi",
    "skills",
    "subagents",
    "worktree"
  ],
  "bin": {
    "picc": "bin/picc.mjs"
  },
  "files": [
    "src",
    "picc",
    "bin",
    "examples",
    "doc/*.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"**/e2e-*.test.ts\"",
    "test:e2e": "vitest run test/e2e-live-pi.test.ts",
    "gen:capabilities": "node scripts/gen-capability-matrix.mjs",
    "prepublishOnly": "npm run typecheck"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.80.6",
    "@earendil-works/pi-ai": "^0.80.6",
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "picomatch": "^4.0.5",
    "typebox": "1.1.38",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
